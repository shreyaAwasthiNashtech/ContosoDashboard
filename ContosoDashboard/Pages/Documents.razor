@page "/documents"
@attribute [Authorize]
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Forms
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IDocumentService DocumentService

<PageTitle>My Documents - ContosoDashboard</PageTitle>

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>My Documents</h1>
    </div>

    <div class="card mb-4">
        <div class="card-header">Upload documents</div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label" for="document-title">Title</label>
                    <input id="document-title" class="form-control" @bind="title" />
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="document-category">Category</label>
                    <select id="document-category" class="form-select" @bind="category">
                        <option value="">Select a category</option>
                        @foreach (var option in categories)
                        {
                            <option value="@option">@option</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="document-files">Files</label>
                    <InputFile id="document-files" OnChange="SelectFiles" multiple />
                </div>
            </div>
            <div class="mt-3">
                <button class="btn btn-primary" @onclick="Upload" disabled="@uploading">
                    @(uploading ? "Uploading..." : "Upload")
                </button>
            </div>
            @if (uploading)
            {
                <div class="alert alert-info mt-3" role="status">Uploading and validating files...</div>
            }
            @if (!string.IsNullOrWhiteSpace(message))
            {
                <div class="alert @(uploadSucceeded ? "alert-success" : "alert-danger") mt-3" role="alert">
                    @message
                </div>
            }
            @if (errors.Count > 0)
            {
                <ul class="alert alert-danger mt-3">
                    @foreach (var error in errors)
                    {
                        <li>@error</li>
                    }
                </ul>
            }
            <small class="text-muted">Training-only safety validation is a simulation, not genuine malware detection. Maximum 25,000,000 bytes per file.</small>
        </div>
    </div>

    @if (documents is null)
    {
        <p><em>Loading...</em></p>
    }
    else if (documents.Count == 0)
    {
        <div class="alert alert-info">No documents uploaded yet.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr><th>Title</th><th>Category</th><th>Uploaded</th><th>Size</th><th>Project</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var document in documents)
                    {
                        <tr>
                            <td>@document.Title</td>
                            <td>@document.Category</td>
                            <td>@document.UploadedUtc.ToLocalTime().ToString("g")</td>
                            <td>@document.FileSizeBytes.ToString("N0") bytes</td>
                            <td>@(document.ProjectName ?? "Personal")</td>
                            <td><a class="btn btn-sm btn-outline-primary" href="@($"/documents/download/{document.DocumentId}")">Download</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private readonly string[] categories = ["Project Documents", "Team Resources", "Personal Files", "Reports", "Presentations", "Other"];
    private IReadOnlyList<DocumentListItem>? documents;
    private readonly List<IBrowserFile> selectedFiles = [];
    private readonly List<string> errors = [];
    private string title = string.Empty;
    private string category = string.Empty;
    private string? message;
    private bool uploadSucceeded;
    private bool uploading;

    protected override async Task OnInitializedAsync() => await LoadDocuments();

    private void SelectFiles(InputFileChangeEventArgs args)
    {
        selectedFiles.Clear();
        selectedFiles.AddRange(args.GetMultipleFiles(100));
        message = null;
        errors.Clear();
    }

    private async Task Upload()
    {
        errors.Clear();
        message = null;
        uploadSucceeded = false;
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (!int.TryParse(state.User.FindFirstValue(ClaimTypes.NameIdentifier), out var userId))
        {
            errors.Add("You must be signed in to upload documents.");
            return;
        }

        uploading = true;
        try
        {
            var request = new DocumentUploadRequest(title, null, category, null, null);
            var result = await DocumentService.UploadBatchAsync(userId, selectedFiles.Select(file => (file, request)).ToList());
            if (result.Count == 0)
            {
                uploadSucceeded = true;
                message = "Upload completed successfully.";
                selectedFiles.Clear();
                title = string.Empty;
                category = string.Empty;
                await LoadDocuments();
            }
            else
            {
                errors.AddRange(result);
            }
        }
        finally
        {
            uploading = false;
        }
    }

    private async Task LoadDocuments()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (int.TryParse(state.User.FindFirstValue(ClaimTypes.NameIdentifier), out var userId))
            documents = await DocumentService.GetMyDocumentsAsync(userId);
        else
            documents = [];
    }
}
